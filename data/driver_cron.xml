<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_driver_license_expiry" model="ir.cron">
        <field name="name">تنبيه انتهاء رخص السائقين</field>
        <field name="model_id" ref="model_driver_profile"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_license_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
