<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_vehicle_handover" model="ir.actions.report">
        <field name="name">صيانة قبل الاستلام</field>
        <field name="model">vehicle.handover</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tourism_company.report_vehicle_handover_document</field>
        <field name="report_file">tourism_company.report_vehicle_handover_document</field>
        <field name="print_report_name">'استلام - %s' % (object.vehicle_id.plate_number or '')</field>
        <field name="binding_model_id" ref="model_vehicle_handover"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_vehicle_handover_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl" style="text-align: right;">

                        <h3 class="text-center mb-3">صيانة قبل الاستلام</h3>

                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 20%;">اسم السائق</th>
                                    <td style="width: 30%;"><span t-field="o.driver_id.name"/></td>
                                    <th style="width: 20%;">العداد</th>
                                    <td style="width: 30%;"><span t-field="o.odometer"/></td>
                                </tr>
                                <tr>
                                    <th>اليوم</th>
                                    <td><span t-field="o.date"/></td>
                                    <th>رقم السيارة</th>
                                    <td><span t-field="o.vehicle_id.plate_number"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th style="width: 6%;" class="text-center">م</th>
                                    <th>البند</th>
                                    <th style="width: 8%;" class="text-center">نعم</th>
                                    <th style="width: 8%;" class="text-center">لا</th>
                                    <th style="width: 25%;">ملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="l">
                                    <tr>
                                        <td class="text-center"><t t-esc="l_index + 1"/></td>
                                        <td><span t-field="l.name"/></td>
                                        <td class="text-center">
                                            <span style="display:inline-block; width:16px; height:16px; border:1px solid #000; line-height:14px; font-weight:bold;">
                                                <t t-if="l.is_yes">X</t>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span style="display:inline-block; width:16px; height:16px; border:1px solid #000; line-height:14px; font-weight:bold;">
                                                <t t-if="l.is_no">X</t>
                                            </span>
                                        </td>
                                        <td><span t-field="l.note"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- عداد الوقود -->
                        <h6 class="mt-3">مستوى الوقود</h6>
                        <t t-set="fx" t-value="{'e': 30, 'q1': 105, 'h': 180, 'q3': 255, 'f': 330}"/>
                        <div style="direction: ltr; text-align: center;">
                            <svg width="360" height="70" xmlns="http://www.w3.org/2000/svg">
                                <line x1="30" y1="40" x2="330" y2="40" stroke="#000" stroke-width="3"/>
                                <line x1="30" y1="30" x2="30" y2="50" stroke="#000" stroke-width="2"/>
                                <line x1="105" y1="33" x2="105" y2="47" stroke="#000" stroke-width="2"/>
                                <line x1="180" y1="30" x2="180" y2="50" stroke="#000" stroke-width="2"/>
                                <line x1="255" y1="33" x2="255" y2="47" stroke="#000" stroke-width="2"/>
                                <line x1="330" y1="30" x2="330" y2="50" stroke="#000" stroke-width="2"/>
                                <text x="30" y="68" text-anchor="middle" font-size="16" font-weight="bold">E</text>
                                <text x="180" y="68" text-anchor="middle" font-size="13">1/2</text>
                                <text x="330" y="68" text-anchor="middle" font-size="16" font-weight="bold">F</text>
                                <t t-if="o.fuel_level">
                                    <polygon t-attf-points="#{fx[o.fuel_level] - 8},4 #{fx[o.fuel_level] + 8},4 #{fx[o.fuel_level]},28" fill="#c00"/>
                                </t>
                            </svg>
                        </div>

                        <t t-if="o.note">
                            <h6 class="mt-3">ملاحظات عامة</h6>
                            <div class="border p-2" style="white-space: pre-wrap;"><span t-field="o.note"/></div>
                        </t>

                        <div class="row mt-5">
                            <div class="col-6 text-center">توقيع السائق: ______________</div>
                            <div class="col-6 text-center">توقيع المسؤول: ______________</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>