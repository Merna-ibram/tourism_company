<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vehicle_handover_form" model="ir.ui.view">
        <field name="name">vehicle.handover.form</field>
        <field name="model">vehicle.handover</field>
        <field name="arch" type="xml">
            <form string="صيانة قبل الاستلام">
                <header>
                    <button name="%(action_report_vehicle_handover)d"
                            string="طباعة"
                            type="action"
                            class="btn-primary"
                            icon="fa-print"
                            invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="driver_id" readonly="id" options="{'no_create': True}"/>
                            <field name="odometer" readonly="id"/>
                        </group>
                        <group>
                            <field name="date" readonly="id"/>
                            <field name="vehicle_locked" invisible="1"/>
                            <field name="vehicle_id" readonly="id or vehicle_locked" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="id">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle"/>
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="is_yes"/>
                            <field name="is_no"/>
                            <field name="note"/>
                        </tree>
                    </field>
                    <group string="مستوى الوقود (من E فارغ إلى F ممتلئ)">
                        <field name="fuel_level" widget="radio" readonly="id" options="{'horizontal': True}" nolabel="1"/>
                    </group>
                    <group>
                        <field name="note" readonly="id" placeholder="ملاحظات عامة..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_vehicle_handover_tree" model="ir.ui.view">
        <field name="name">vehicle.handover.tree</field>
        <field name="model">vehicle.handover</field>
        <field name="arch" type="xml">
            <tree string="صيانة قبل الاستلام">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="odometer"/>
            </tree>
        </field>
    </record>

    <record id="action_vehicle_handover" model="ir.actions.act_window">
        <field name="name">صيانة قبل الاستلام</field>
        <field name="res_model">vehicle.handover</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- يظهر في قائمة Action داخل شاشة السيارة، والسيارة تتحدد تلقائياً -->
    <record id="action_vehicle_handover_from_vehicle" model="ir.actions.act_window">
        <field name="name">صيانة قبل الاستلام</field>
        <field name="res_model">vehicle.handover</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_vehicle_id': active_id}</field>
        <field name="binding_model_id" ref="model_vehicle_vehicle"/>
        <field name="binding_view_types">form</field>
    </record>

    <menuitem id="menu_vehicle_handover"
              name="صيانة قبل الاستلام"
              parent="menu_tourism_company_root"
              action="action_vehicle_handover"
              sequence="50"/>

</odoo>