<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_trip_order" model="ir.sequence">
            <field name="name">أمر التشغيل</field>
            <field name="code">trip.order</field>
            <field name="prefix">رحلة </field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- كل 15 دقيقة: الرحلات المؤكدة اللي وقت تحركها جه تخلي العربية والسائق (في رحلة) -->
        <record id="cron_trip_order_sync_states" model="ir.cron">
            <field name="name">أمر التشغيل: تحديث حالة العربية والسائق</field>
            <field name="model_id" ref="model_trip_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_trip_states()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>