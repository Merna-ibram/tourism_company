<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_vehicle_expiry_check" model="ir.cron">
            <field name="name">السيارات: تنبيه انتهاء الرخصة والتأمين</field>
            <field name="model_id" ref="model_vehicle_vehicle"/>
            <field name="state">code</field>
